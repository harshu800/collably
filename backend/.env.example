ENV=dev
DEBUG=true
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5432/marketplace
DATABASE_URL_SYNC=postgresql+psycopg2://marketplace:marketplace@localhost:5432/marketplace

# --- Clerk (replace with real keys from the Clerk dashboard) -----------------
# API keys: https://dashboard.clerk.com/last-active?path=api-keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Webhook secret from Clerk's Webhooks page (svix-compatible).
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
# JWKS endpoint + issuer for your Clerk instance.
# Example JWKS: https://your-tenant.clerk.accounts.dev/.well-known/jwks.json
# Example issuer: https://your-tenant.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_ISSUER=

# HS256 signing key for internal signed-file-download tokens. Must be >=32
# chars in production. Rotate independently of Clerk's keys.
FILE_TOKEN_SECRET=change-me-min-32-chars-xxxxxxxxxxxx

# Production: set to your real Vercel domain (no wildcard).
# Example: CORS_ORIGINS=https://collably.vercel.app,https://www.collably.in
# Multiple domains: comma-separated, no spaces.
CORS_ORIGINS=http://localhost:3000
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-mock-secret
PAYOUT_FIELD_ENC_KEY=change-me-base64-32-bytes-xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
# Leave both blank when using the AWS default credential chain/workload identity.
# Otherwise supply a narrowly scoped IAM access key pair via a secret manager.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
ENABLE_MOCK_PAYMENT_ENDPOINTS=true
TRUST_PROXY=false

